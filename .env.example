SIGNATUS_AI_BASE_URL=http://127.0.0.1:8001
SIGNATUS_AI_EVENTS_URL=ws://127.0.0.1:8001/ws/events
SIGNATUS_WORKSITE_DIR=./config/worksites
SIGNATUS_FACE_MATCH_MIN_COSINE_SIMILARITY=0.35

# Used by the separate PySide6 display process.
SIGNATUS_CORE_URL=http://127.0.0.1:8000

SIGNATUS_MODEL_PATH=./models/yolo26s100e18b_int8_openvino_model
SIGNATUS_CAMERA_SOURCE=0
SIGNATUS_PERSON_CLASS=Person
SIGNATUS_TRACK_LOST_TIMEOUT_SECONDS=1.5
SIGNATUS_AI_TRACKING_ENABLED=false
SIGNATUS_PPE_ASSOCIATION=single_person_frame
SIGNATUS_FRAME_SHM_ENABLED=true
SIGNATUS_FRAME_SHM_NAME=signatus_camera_v1
SIGNATUS_PREVIEW_MAX_FRAME_BYTES=6220800

# Used by the GUI to decide when an attached preview has stopped updating.
SIGNATUS_FRAME_STALE_SECONDS=3.0

# OpenCV Zoo FP32 face models. YuNet runtime defaults follow the official demo
# and remain subject to deployment validation alongside the 0.35 minimum cosine
# similarity.
SIGNATUS_FACE_DETECTOR_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
SIGNATUS_FACE_RECOGNIZER_MODEL_PATH=./models/face_recognition_sface_2021dec.onnx
SIGNATUS_FACE_DETECTOR_SCORE_THRESHOLD=0.9
SIGNATUS_FACE_DETECTOR_NMS_THRESHOLD=0.3
SIGNATUS_FACE_DETECTOR_TOP_K=5000
